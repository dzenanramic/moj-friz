{
  "compilerOptions": {
    "target": "ES2022",
    // `DOM` is for callbacks that Playwright evaluates inside the page (e.g. CSP listeners), not
    // for Node-side code.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
